# Copy to .env locally. Do not share the populated file.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=intelligent_dynamic_scheduling
DB_USER=root
DB_PASSWORD=
CSRF_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_DAILY_USER_LIMIT=30
AI_DAILY_GLOBAL_LIMIT=300
AI_MAX_OUTPUT_TOKENS=800
AI_EXPLANATION_MAX_OUTPUT_TOKENS=1600
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARS=2000
